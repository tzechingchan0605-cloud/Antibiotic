{
  "name": "vl4-antibiotics-inquiry-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && node paperwork/build.mjs --if-needed",
    "start": "node scripts/serve.mjs",
    "dev": "npm run build && npm start",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "paper:build": "node scripts/build.mjs && node paperwork/build.mjs",
    "paper:check": "node paperwork/build.mjs --check",
    "paper:test": "python tests/paperwork_pdf.py && playwright test tests/paperwork.spec.js"
  },
  "dependencies": {
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "esbuild": "0.25.12"
  }
}
